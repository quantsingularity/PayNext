# ─── Stage 1: Build React app ──────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

# Install dependencies first (layer caching)
COPY package*.json ./
RUN npm ci --prefer-offline

COPY . .
ARG REACT_APP_API_URL=/api
ENV REACT_APP_API_URL=$REACT_APP_API_URL
RUN npm run build

# ─── Stage 2: Serve with Nginx ────────────────────────────────────────────────
FROM nginx:1.25-alpine

# Use the application's nginx config as the main config. It defines the /api reverse
# proxy to the gateway (preserving the /api prefix the gateway routes on) and the SPA
# fallback. This matches web-frontend/Dockerfile, which also installs nginx.conf as the
# main config. The earlier COPY here targeted conf.d, which only accepts server-block
# fragments, not a full config, and used invalid shell syntax on a COPY instruction.
COPY --from=builder /app/nginx.conf /etc/nginx/nginx.conf

COPY --from=builder /app/build /usr/share/nginx/html

# Security: run as non-root
RUN addgroup -S paynext && adduser -S -G paynext paynext && \
    chown -R paynext:paynext /usr/share/nginx/html && \
    touch /var/run/nginx.pid && \
    chown paynext:paynext /var/run/nginx.pid

USER paynext
EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget -q --spider http://localhost:80/ || exit 1
